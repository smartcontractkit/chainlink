#!/usr/bin/env bash

set -euo pipefail

# latest release tag
GIT_TAG="v0.61.10"

CHECKOUT_DIR="${HOME}/wasmd-checkout"
BUILD_DIR="${HOME}/wasmd-build"

git clone https://github.com/CosmWasm/wasmd --branch "${GIT_TAG}" "${CHECKOUT_DIR}"
cd "${CHECKOUT_DIR}"
git checkout "${GIT_TAG}"
# wasmd v0.61.10 pulls sonic v1.14.x (via gin), which fails on Go 1.26+ (undefined GoMapIterator).
# Build the wasmd CLI with Go 1.25.x; chainlink itself still uses Go 1.26.4.
GOTOOLCHAIN=go1.25.8 GOPATH="${BUILD_DIR}" make install
