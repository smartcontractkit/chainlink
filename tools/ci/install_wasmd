#!/usr/bin/env bash

set -euo pipefail

# upstream deleted the releases/v0.40.x branch; the tag is still published
GIT_TAG="v0.40.1"

CHECKOUT_DIR="${HOME}/wasmd-checkout"
BUILD_DIR="${HOME}/wasmd-build"

git clone https://github.com/CosmWasm/wasmd --branch "${GIT_TAG}" --depth 1 "${CHECKOUT_DIR}"
cd "${CHECKOUT_DIR}"
GOPATH="${BUILD_DIR}" make install
