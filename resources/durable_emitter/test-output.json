            "expr": "(histogram_quantile(0.50, sum by (le) (rate(durable_emitter_emit_duration_seconds_bucket{exported_job=\"durable-emitter-driver\"}[$__rate_interval])))) \u003e 0",
            "format": "",
            "legendFormat": "p50"
