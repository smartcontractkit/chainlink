          {
            "expr": "(histogram_quantile(0.99, sum by (le) (rate(durable_emitter_emit_duration_seconds_bucket{exported_job=\"durable-emitter-driver\"}[$__rate_interval])))) \u003e 0",
            "format": "",
            "legendFormat": "p99"
          },
          {
            "expr": "rate(durable_emitter_emit_duration_seconds_sum{exported_job=\"durable-emitter-driver\"}[$__rate_interval]) / clamp_min(rate(durable_emitter_emit_duration_seconds_count{exported_job=\"durable-emitter-driver\"}[$__rate_interval]), 1e-15)",
            "format": "",
            "legendFormat": "mean"
          }
